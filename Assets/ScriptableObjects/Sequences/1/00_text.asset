  m_Script: {fileID: 11500000, guid: 77be8d3abc4d614408c62dfb3862c314, type: 3}
  m_Name: 00_text
  m_EditorClassIdentifier: Assembly-CSharp::SpeakerTextSO
  dialogues:
  - character: {fileID: 11400000, guid: c8fcfa5882242b84b8bf1fb55659059e, type: 2}
    emotion: 1
    text: "Welcome all!\n\nI\u2019m happy to welcome you to Morgan Sindall\u2019s
      Financial team.\n\nWe\u2019ve got some projects that need your help!"
  - character: {fileID: 11400000, guid: c8fcfa5882242b84b8bf1fb55659059e, type: 2}
    emotion: 0
    text: "We\u2019re putting in a tender for a two stage college in Sussex. We\u2019ve
      worked with the client before and they were 80% happy with our work. We\u2019re
      looking for a profit of 10% and the project is going to cost somewhere between
      10-12 million pounds."
  - character: {fileID: 11400000, guid: c8fcfa5882242b84b8bf1fb55659059e, type: 2}
    emotion: 0
    text: 'We need to assign some members of staff to review the proposal and given
      an estimated cost.


      What do you think we should do?'
